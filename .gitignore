# 依赖库（这个文件夹几百MB，绝对不能传）
node_modules/
dist/
build/

# 环境配置文件（包含你的数据库账号密码，千万别传！）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs
*.log

# 编辑器私有配置（VS Code / WebStorm）
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统临时文件
.DS_Store
Thumbs.db

# 数据库/测试缓存
.eslintcache
.node_repl_history